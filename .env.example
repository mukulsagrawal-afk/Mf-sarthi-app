# Copy this file to .env and fill in real values before running the server.
# Never commit the real .env file to version control.

# Port the server listens on
PORT=4000

# Secret used to sign login sessions (JWT). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=

# Key used to encrypt sensitive fields (PAN numbers) in the database. Must decode
# to exactly 32 bytes. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Where the SQLite database file and backups are stored.
# Locally this default (./server/data) is fine.
# ON A REAL DEPLOYMENT (Render, etc.), this MUST point at a mounted persistent disk,
# not the app's own folder — most hosts wipe the app folder on every redeploy/restart,
# which means every client you added is gone. On Render: add a "Disk" to your service
# (Settings > Disks), mount it at /var/data, then set DATA_DIR=/var/data below.
DATA_DIR=./server/data

# --- Email (for follow-up / meeting reminders, and daily backup copies) ---
# Leave these blank to run in "dry run" mode: reminders are logged to
# server/data/email-log.jsonl instead of actually being sent. Fill them in with
# real SMTP credentials (e.g. from Gmail, Zoho Mail, SendGrid, Brevo) to send for real.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="MF Sarthi <no-reply@example.com>"

# Optional but recommended: an email address that gets a copy of the daily database
# backup as an attachment. This is your safety net if the persistent disk itself is
# ever lost or corrupted — a backup sitting on the same disk it backs up doesn't help
# in that case. Requires SMTP_HOST/USER/PASS above to be filled in.
BACKUP_EMAIL_TO=

# Comma-separated origins allowed to call this API (your frontend's URL in production)
CORS_ORIGIN=http://localhost:4000
